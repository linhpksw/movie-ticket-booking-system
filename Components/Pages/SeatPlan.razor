@page "/seat-plan/{showtimeId:int}"
@inject IShowtimeService ShowtimeService
@inject IMovieService MovieService
@inject IScreenSeatService ScreenSeatService
@inject NavigationManager Navigation

@code {
    [Parameter]
    public int ShowtimeId { get; set; }

    private ShowtimeDto? showtime;
    private MovieDto? movie;
    private CinemaDto? cinema;
    private List<ShowtimeDto> showtimes = new List<ShowtimeDto>();
    private List<ScreenSeatDto> screenSeats = new List<ScreenSeatDto>();

    private LoadState CurrentState = LoadState.Loading;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        CurrentState = LoadState.Loading;

        try
        {
            showtime = await ShowtimeService.GetByIdAsync(ShowtimeId);
            movie = await MovieService.GetByIdAsync(showtime.MovieId);
            cinema = await ShowtimeService.GetCinemaByShowtimeId(showtime.ShowtimeId);
            showtimes = await ShowtimeService.GetShowTimeByMovieAndCinemaWithinDay(movie.MovieId, cinema.CinemaId, showtime.ShowDate);
            screenSeats = await ScreenSeatService.GetScreenSeatsByShowtime(showtime.MovieId, cinema.CinemaId, showtime.ShowDate, showtime.ShowTime);

            if (showtime != null && movie != null && cinema != null && showtimes != null)
            {
                CurrentState = LoadState.Success;
            } 
            else
            {
                Navigation.NavigateTo("/error", forceLoad: true);
            }
        } 
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            CurrentState = LoadState.Failure;
            Navigation.NavigateTo("/error", forceLoad: true);
        }
    }

    // Get seat type label
    private string GetSeatTypeName(int seatTypeId) => seatTypeId switch
    {
        1 => "Thường",    // Normal
        2 => "VIP",       // VIP
        3 => "Sweetbox",  // Sweetbox
        _ => "Unknown"
    };

    // Get a CSS class based on seat type (for styling the subtitle)
    private string GetSeatTypeClass(int seatTypeId) => seatTypeId switch
    {
        1 => "",       // e.g., default (Thường)
        2 => "brown",  // e.g., "brown" class for VIP
        3 => "pink",   // e.g., "pink" class for Sweetbox
        _ => ""
    };

    // Map seat type to image path
    private string GetSeatImage(int seatTypeId) => seatTypeId switch
    {
        1 => "assets/images/movie/normal-free.png",
        2 => "assets/images/movie/vip-free.png",
        3 => "assets/images/movie/sweetbox-free.png",
        _ => "assets/images/movie/normal-free.png"
    };

    // Extract the row letter from the seat label (e.g., 'A1' -> 'A', 'F1,F2' -> 'F')
    private string GetRowLetter(string seatLabel)
    {
        // If seatLabel starts with a letter, return that letter
        // e.g. "A1" => "A", "F1,F2" => "F"
        if (!string.IsNullOrEmpty(seatLabel))
        {
            return seatLabel.Substring(0, 1).ToUpper();
        }
        return "?";
    }

    // Extract the seat number for sorting (e.g., "A10" => 10, "F1,F2" => 1)
    private int ParseSeatNumber(string seatLabel)
    {
        // If multiple seats (like "F1,F2"), we take the first number
        // Using Regex to find the first sequence of digits
        var match = Regex.Match(seatLabel, @"\d+");
        if (match.Success && int.TryParse(match.Value, out int seatNum))
        {
            return seatNum;
        }
        return 0; // fallback if not found
    }

    // Split seats into 4-6-4 (for Thường & VIP) or 2-3-2 (for Sweetbox)
    private List<List<ScreenSeatDto>> SplitSeatsIntoGroups(List<ScreenSeatDto> seats, int seatTypeId)
    {
        List<List<ScreenSeatDto>> groupedSeats = new();
        int[] pattern = seatTypeId == 3 ? new int[] { 2, 3, 2 } : new int[] { 4, 6, 4 };

        int index = 0;
        foreach (int groupSize in pattern)
        {
            if (index < seats.Count)
            {
                groupedSeats.Add(seats.Skip(index).Take(groupSize).ToList());
                index += groupSize;
            }
        }
        return groupedSeats;
    }
}


@if (CurrentState == LoadState.Loading)
{
    <Preloader />
}
else
{
    <!-- ==========Banner-Section========== -->
    <section class="details-banner hero-area bg_img seat-plan-banner" data-background="assets/images/banner/banner04.jpg">
        <div class="container">
            <div class="details-banner-wrapper">
                <div class="details-banner-content style-two">
                    <h3 class="title">@movie.Title</h3>
                    <div class="tags">
                        <a href="#0">@cinema.CinemaName</a>
                        <a href="#0">@movie.Language - @showtime.ExperienceType</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ==========Banner-Section========== -->

    <!-- ==========Page-Title========== -->
    <section class="page-title bg-one">
        <div class="container">
            <div class="page-title-area">
                <div class="item md-order-1">
                    <a href="movie-ticket-plan.html" class="custom-button back-button">
                        <i class="flaticon-double-right-arrows-angles"></i>back
                    </a>
                </div>
                <div class="item date-item">
                    <span class="date">@showtime.ShowDate.ToString("dddd, dd MMMM yyyy")</span>
                    <select class="select-bar">
                        @if (showtimes != null && showtimes.Any())
                        {
                            @foreach (var show in showtimes)
                            {
                                <option value="@show.ShowtimeId">@show.ShowTime</option>
                            }
                        }
                        else
                        {
                            <option disabled>No showtimes available</option>
                        }
                    </select>
                </div>
                <div class="item">
                    <h5 class="title">05:00</h5>
                    <p>Mins Left</p>
                </div>
            </div>
        </div>
    </section>
    <!-- ==========Page-Title========== -->

    <!-- ==========Movie-Section========== -->
    <div class="seat-plan-section padding-bottom padding-top">
        <div class="container">
            <div class="screen-area">
                <h4 class="screen">screen</h4>
                <div class="screen-thumb">
                    <img src="assets/images/movie/screen-thumb.png" alt="movie">
                </div>

                @if (screenSeats == null || !screenSeats.Any())
                {
                    <p>No seats to display.</p>
                }
                else
                {
                    <!-- Group seats by type (1=Thường, 2=VIP, 3=Sweetbox) -->
                    @foreach (var seatTypeGroup in screenSeats.GroupBy(s => s.SeatTypeId).OrderBy(g => g.Key))
                    {
                        <h5 class="subtitle @GetSeatTypeClass(seatTypeGroup.Key)">
                            @GetSeatTypeName(seatTypeGroup.Key)
                        </h5>

                        <div class="screen-wrapper">
                            <ul class="seat-area">
                                <!-- Group each seat type by the row letter (e.g. 'A', 'B', 'C'...) -->
                                @foreach (var rowGroup in seatTypeGroup.GroupBy(s => GetRowLetter(s.SeatLabel)).OrderBy(g => g.Key))  
                                {
                                    <li class="seat-line">
                                        <span>@rowGroup.Key</span>
                                        <ul class="seat--area">
                                            @foreach (var seatChunk in SplitSeatsIntoGroups(rowGroup.OrderBy(s => ParseSeatNumber(s.SeatLabel)).ToList(), seatTypeGroup.Key))
                                            {
                                                <li class="front-seat">
                                                    <ul>
                                                        @foreach (var seat in seatChunk)
                                                        {
                                                            <li class="single-seat seat-free">
                                                                <img src="@GetSeatImage(seat.SeatTypeId)" alt="seat" />
                                                                <span class="sit-num">@seat.SeatLabel</span>
                                                                
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        </ul>
                                        <span>@rowGroup.Key</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            <div class="proceed-book bg_img" data-background="assets/images/movie/movie-bg-proceed.jpg">
                <div class="proceed-to-book">
                    <div class="book-item">
                        <span>You have Choosed Seat</span>
                        <h3 class="title">d9, d10</h3>
                    </div>
                    <div class="book-item">
                        <span>total price</span>
                        <h3 class="title">$150</h3>
                    </div>
                    <div class="book-item">
                        <a href="movie-checkout.html" class="custom-button">proceed</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ==========Movie-Section========== -->
}

<ScrollToTop />