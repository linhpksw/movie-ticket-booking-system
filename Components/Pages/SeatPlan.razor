@page "/seat-plan/{showtimeId:int}"
@inject IShowtimeService ShowtimeService
@inject ISeatLockService SeatLockService
@inject IMovieService MovieService
@inject IScreenSeatService ScreenSeatService
@inject NavigationManager Navigation
@inject IHubContext<MovieHub> hub
@inject IJSRuntime JS

@code {
    [Parameter]
    public int ShowtimeId { get; set; }

    private int userId = 23;
    private TimeSpan timeLeft;
    private readonly TimeSpan DefaultTimeSpan = TimeSpan.FromMinutes(CommonConstant.COUNT_DOWN_TIMER_MINS);
    private bool isTimeUp = false;
    private bool _isCountdownRunning = false;
    private SeatLock? userLock;
    private ShowtimeDto? showtime;
    private MovieDto? movie;
    private CinemaDto? cinema;
    private List<ShowtimeDto> showtimes = new List<ShowtimeDto>();
    private List<ScreenSeatDto> screenSeats = new List<ScreenSeatDto>();
    private Dictionary<int, decimal> seatTypePriceMap = new();
    private Dictionary<int, SeatStatus> seatAvailabilities = new();
    private List<ScreenSeatDto> chosenSeats = new List<ScreenSeatDto>();
    private decimal totalPrice = 0m;
    private LoadState CurrentState = LoadState.Loading;
    private string? ErrorMessage;
    private DotNetObjectReference<SeatPlan>? _dotNetRef;

    // Realtime Signal R
    [JSInvokable]
    public async Task RefreshSeatData()
    {
        await LoadDataAsync();

        // Check if we have a valid lock and if the countdown isn't already running.
        if (userLock != null && !_isCountdownRunning)
        {
            _ = CountdownRoutine();
        }

        StateHasChanged();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerSeatLockCallback", _dotNetRef);
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        // Start the countdown only if a seat lock exists and the countdown isn't already running.
        if (userLock != null && !_isCountdownRunning)
        {
            _ = CountdownRoutine();
        }
    }

    private async Task CountdownRoutine()
    {
        // Prevent multiple overlapping loops
        if (_isCountdownRunning) return;

        _isCountdownRunning = true;

        while (timeLeft.TotalSeconds > 0)
        {
            await Task.Delay(1000);

            // **Check if user canceled the loop (e.g., by unlocking all seats)**
            if (!_isCountdownRunning)
            {
                // Break immediately, do NOT subtract a second
                break;
            }

            timeLeft = timeLeft.Subtract(TimeSpan.FromSeconds(1));
            await InvokeAsync(StateHasChanged);

            // If time left is zero or negative, break
            if (timeLeft.TotalSeconds <= 0)
            {
                break;
            }
        }

        // If we left the loop because the user cleared seats, stop here
        if (!_isCountdownRunning)
        {
            // The countdown was manually stopped
            return;
        }

        // Otherwise, we ran out of time
        isTimeUp = true;
        await InvokeAsync(StateHasChanged);

        if (userLock != null)
        {
            await SeatLockService.UnlockAllSeatsByExpiryAsync(ShowtimeId, userId);
        }

        _isCountdownRunning = false;

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task LoadDataAsync()
    {
        CurrentState = LoadState.Loading;

        try
        {
            showtime = await ShowtimeService.GetByIdAsync(ShowtimeId);
            movie = await MovieService.GetByIdAsync(showtime.MovieId);
            cinema = await ShowtimeService.GetCinemaByShowtimeId(showtime.ShowtimeId);
            showtimes = await ShowtimeService.GetShowTimeByMovieAndCinemaWithinDay(movie.MovieId, cinema.CinemaId, showtime.ShowDate);
            screenSeats = await ScreenSeatService.GetScreenSeatsByShowtime(showtime.MovieId, cinema.CinemaId, showtime.ShowDate, showtime.ShowTime);
            seatTypePriceMap = await ScreenSeatService.GetSeatTypePriceMapAsync();

            // NEW: get the seat availability from the SeatLockService
            if (screenSeats.Any())
            {
                var seatIds = screenSeats.Select(s => s.ScreenSeatId).ToList();
                seatAvailabilities = await SeatLockService.GetSeatsAvailabilityAsync(ShowtimeId, seatIds);

                // Instead of starting with an empty chosenSeats list,
                // retrieve the seats already locked by the current user from the DB.
                chosenSeats = screenSeats
                    .Where(s => seatAvailabilities.TryGetValue(s.ScreenSeatId, out var status)
                                && !status.IsAvailable && status.LockedBy == userId && !status.IsSold)
                    .ToList();

                // Recalculate the total price from the chosen seats.
                totalPrice = chosenSeats.Sum(s => seatTypePriceMap.TryGetValue(s.SeatTypeId, out decimal price) ? price : 0);
            }


            if (showtime != null && movie != null && cinema != null && showtimes != null)
            {
                CurrentState = LoadState.Success;

                userLock = await SeatLockService.GetUserLockAsync(ShowtimeId, userId);

                if (userLock != null)
                {
                    // Use the lock's expiry time to calculate remaining time.
                    DateTime now = DateTime.Now;
                    timeLeft = userLock.LockExpiryTime - now;
                    if (timeLeft.TotalSeconds < 0)
                    {
                        timeLeft = TimeSpan.Zero;
                    }
                }
                else
                {
                    // If no lock exists, initialize to the full countdown.
                    // (This case should not occur if a seat has been clicked.)
                    timeLeft = TimeSpan.FromMinutes(CommonConstant.COUNT_DOWN_TIMER_MINS);
                }
            }
            else
            {
                // Navigation.NavigateTo("/error", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            CurrentState = LoadState.Failure;
            // Navigation.NavigateTo("/error", forceLoad: true);
        }
    }

    // Get seat type label
    private string GetSeatTypeName(int seatTypeId) => seatTypeId switch
    {
        1 => "Thường",    // Normal
        2 => "VIP",       // VIP
        3 => "Sweetbox",  // Sweetbox
        _ => "Unknown"
    };

    // Get a CSS class based on seat type (for styling the subtitle)
    private string GetSeatTypeClass(int seatTypeId) => seatTypeId switch
    {
        1 => "",       // e.g., default (Thường)
        2 => "brown",  // e.g., "brown" class for VIP
        3 => "pink",   // e.g., "pink" class for Sweetbox
        _ => ""
    };

    // Return the correct seat image based on status
    private string GetSeatImage(ScreenSeatDto seat)
    {
        if (seatAvailabilities.TryGetValue(seat.ScreenSeatId, out var status))
        {
            if (status.IsSold || (!status.IsAvailable && status.LockedBy != userId))
            {
                return seat.SeatTypeId switch
                {
                    1 => "assets/images/movie/seat-booked.png",
                    2 => "assets/images/movie/seat-booked.png",
                    3 => "assets/images/movie/sweetbox-booked.png",
                    _ => "assets/images/movie/seat-booked.png"
                };
            }
            if (!status.IsAvailable && status.LockedBy == userId)
            {
                // Show the image for a seat chosen by the current user.
                return "assets/images/movie/seat-chosen.png";
            }
        }

        return seat.SeatTypeId switch
        {
            1 => "assets/images/movie/normal-free.png",
            2 => "assets/images/movie/vip-free.png",
            3 => "assets/images/movie/sweetbox-free.png",
            _ => "assets/images/movie/normal-free.png"
        };
    }

    // Extract the row letter from the seat label (e.g., 'A1' -> 'A', 'F1,F2' -> 'F')
    private string GetRowLetter(string seatLabel)
    {
        // If seatLabel starts with a letter, return that letter
        // e.g. "A1" => "A", "F1,F2" => "F"
        if (!string.IsNullOrEmpty(seatLabel))
        {
            return seatLabel.Substring(0, 1).ToUpper();
        }
        return "?";
    }

    // Extract the seat number for sorting (e.g., "A10" => 10, "F1,F2" => 1)
    private int ParseSeatNumber(string seatLabel)
    {
        // If multiple seats (like "F1,F2"), we take the first number
        // Using Regex to find the first sequence of digits
        var match = Regex.Match(seatLabel, @"\d+");
        if (match.Success && int.TryParse(match.Value, out int seatNum))
        {
            return seatNum;
        }
        return 0; // fallback if not found
    }

    // Split seats into 4-6-4 (for Thường & VIP) or 2-3-2 (for Sweetbox)
    private List<List<ScreenSeatDto>> SplitSeatsIntoGroups(List<ScreenSeatDto> seats, int seatTypeId)
    {
        List<List<ScreenSeatDto>> groupedSeats = new();
        int[] pattern = seatTypeId == 3 ? new int[] { 2, 3, 2 } : new int[] { 4, 6, 4 };

        int index = 0;
        foreach (int groupSize in pattern)
        {
            if (index < seats.Count)
            {
                groupedSeats.Add(seats.Skip(index).Take(groupSize).ToList());
                index += groupSize;
            }
        }
        return groupedSeats;
    }

    private async Task OnSeatClicked(ScreenSeatDto seat)
    {
        if (!IsSeatClickable(seat))
            return;

        bool alreadyChosen = chosenSeats.Any(s => s.ScreenSeatId == seat.ScreenSeatId);
        if (alreadyChosen)
        {
            // The user wants to UN‐choose the seat:
            chosenSeats.RemoveAll(s => s.ScreenSeatId == seat.ScreenSeatId);
            await SeatLockService.UnlockSeatAsync(ShowtimeId, userId, seat.ScreenSeatId);

            // No need to manual update, Signal R will refresh seatAvailabilities automatically.
        }
        else
        {
            // The user wants to choose this seat:
            chosenSeats.Add(seat);
            await SeatLockService.LockSeatAsync(ShowtimeId, userId, seat.ScreenSeatId);

            // No need to manual update, Signal R will refresh seatAvailabilities automatically.
        }

        // If no seats left in chosenSeats, that means user has cleared all
        if (chosenSeats.Count == 0)
        {
            // 1) Optionally ensure the DB no longer has any locks for this user
            //    (Or you already did so one by one above.)
            //    If you want to remove *all* locks at once:
            // await SeatLockService.UnlockAllSeatsAsync(ShowtimeId, userId);

            // 2) Stop the countdown loop & reset
            _isCountdownRunning = false;
            timeLeft = DefaultTimeSpan;
            isTimeUp = false;  
            userLock = null;
        }

        // Recalculate total
        totalPrice = chosenSeats.Sum(s => seatTypePriceMap.TryGetValue(s.SeatTypeId, out decimal price) ? price : 0);

        // Broadcast to all clients so they know seat availability changed
        //    This calls "ReceiveSeatLockUpdate" on the JS side (below).
        await hub.Clients.All.SendAsync("ReceiveSeatLockUpdate");

        // Force UI refresh
        StateHasChanged();
    }

    private bool IsSeatClickable(ScreenSeatDto seat)
    {
        if (seatAvailabilities.TryGetValue(seat.ScreenSeatId, out var status))
        {
            // If the seat is sold, it is not clickable.
            if (status.IsSold)
            {
                return false;
            }
            // If the seat is locked by someone else, it is not clickable.
            if (!status.IsAvailable)
            {
                // Allow clicking if it's locked by the current user (for unlocking).
                return status.LockedBy == userId;
            }
        }
        // If no special status exists, allow clicking.
        return true;
    }
}


@if (CurrentState == LoadState.Loading)
{
    <Preloader />
}
else
{
    <!-- ==========Banner-Section========== -->
    <section class="details-banner hero-area bg_img seat-plan-banner" style="background-image: url('/assets/images/banner/banner04.jpg');">
        <div class="container">
            <div class="details-banner-wrapper">
                <div class="details-banner-content style-two">
                    <h3 class="title">@movie.Title</h3>
                    <div class="tags">
                        <a href="#0">@cinema.CinemaName</a>
                        <a href="#0">@movie.Language - @showtime.ExperienceType</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ==========Banner-Section========== -->
    <!-- ==========Page-Title========== -->
    <section class="page-title bg-one">
        <div class="container">
            <div class="page-title-area">
                <div class="item md-order-1">
                    <a href="movie-ticket-plan.html" class="custom-button back-button">
                        <i class="flaticon-double-right-arrows-angles"></i>back
                    </a>
                </div>
                <div class="item date-item">
                    <span class="date">@showtime.ShowDate.ToString("dddd, dd MMMM yyyy")</span>
                    <select class="select-bar">
                        @if (showtimes != null && showtimes.Any())
                        {
                            @foreach (var show in showtimes)
                            {
                                <option value="@show.ShowtimeId">@show.ShowTime</option>
                            }
                        }
                        else
                        {
                            <option disabled>No showtimes available</option>
                        }
                    </select>
                </div>
                <div class="item">
                    @if (!isTimeUp)
                    {
                        <p>Thời gian đặt chỗ còn</p>
                        <h5 class="title">@timeLeft.ToString(@"mm\:ss")</h5>
                    }
                    else
                    {
                        <h5 class="title">Hết giờ!</h5>
                    }
                </div>
            </div>
        </div>
    </section>
    <!-- ==========Page-Title========== -->
    <!-- ==========Movie-Section========== -->
    <div class="seat-plan-section padding-bottom padding-top">
        <div class="container">
            <div class="screen-area">
                <h4 class="screen">screen</h4>
                <div class="screen-thumb">
                    <img src="assets/images/movie/screen-thumb.png" alt="movie">
                </div>

                @if (screenSeats == null || !screenSeats.Any())
                {
                    <p>No seats to display.</p>
                }
                else
                {
                    <!-- Group seats by type (1=Thường, 2=VIP, 3=Sweetbox) -->
                    @foreach (var seatTypeGroup in screenSeats.GroupBy(s => s.SeatTypeId).OrderBy(g => g.Key))
                    {
                        <h5 class="subtitle @GetSeatTypeClass(seatTypeGroup.Key)">
                            @GetSeatTypeName(seatTypeGroup.Key)
                        </h5>

                        <div class="screen-wrapper">
                            <ul class="seat-area">
                                <!-- Group each seat type by the row letter (e.g. 'A', 'B', 'C'...) -->
                                @foreach (var rowGroup in seatTypeGroup.GroupBy(s => GetRowLetter(s.SeatLabel)).OrderBy(g => g.Key))
                                {
                                    <li class="seat-line">
                                        <span>@rowGroup.Key</span>
                                        <ul class="seat--area">
                                            @foreach (var seatChunk in SplitSeatsIntoGroups(rowGroup.OrderBy(s => ParseSeatNumber(s.SeatLabel)).ToList(), seatTypeGroup.Key))
                                            {
                                                <li class="front-seat">
                                                    <ul>
                                                        @foreach (var seat in seatChunk)
                                                        {
                                                            // If IsSeatClickable is false, do not attach the onclick handler
                                                            bool canClick = IsSeatClickable(seat);
                                                            <li class="single-seat seat-free">
                                                                <img src="@GetSeatImage(seat)" alt="seat"
                                                                style="cursor:@(canClick ? "pointer" : "default")"
                                                                     @onclick="@(canClick ? (() => OnSeatClicked(seat)) : null)" />
                                                                <span class="sit-num">@seat.SeatLabel</span>

                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        </ul>
                                        <span>@rowGroup.Key</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            <div class="proceed-book bg_img" style="background-image: url('/assets/images/movie/movie-bg-proceed.jpg');">
                <div class="proceed-to-book">
                    <div class="book-item">
                        @if (chosenSeats.Any())
                        {
                            <span>Bạn đã chọn ghế</span>
                        }
                        else
                        {
                            <span>Bạn chưa chọn ghế nào</span>
                        }
                        <h3 class="title">
                            @string.Join(", ", chosenSeats
                                     .SelectMany(s => s.SeatLabel.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                     .Select(s => s.Trim()))
                        </h3>
                    </div>
                    <div class="book-item">
                        <span>Tổng tiền</span>
                        <h3 class="title">@NumberUtil.FormatCurrency(totalPrice)</h3>
                    </div>
                    <div class="book-item">
                        <a class="custom-button" @onclick="ProceedToCheckout">Thanh toán</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ==========Movie-Section========== -->

    <script>
        "use strict";

        function registerSeatLockCallback(dotNetRef) {
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/movieHub")
                .build();

            connection.on("ReceiveSeatLockUpdate", function () {
                // Instead of a full reload, call the C# method to refresh the seat data.
                dotNetRef.invokeMethodAsync("RefreshSeatData")
                    .catch(err => console.error(err.toString()));
            });

            connection.start().catch(function (err) {
                console.error(err.toString());
            });
        }
    </script>
}

<ScrollToTop />

@code {
    private void ProceedToCheckout()
    {
        // e.g. Navigate to a checkout page, or do an in‐page flow
        Navigation.NavigateTo($"movie-checkout/{ShowtimeId}", forceLoad: true);
    }
}

