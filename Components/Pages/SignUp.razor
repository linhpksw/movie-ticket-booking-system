@page "/sign-up"
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IUserServices UserServices
@inject ToastService toastService

<!-- Sign-Up Section -->
<section class="account-section bg_img" style="background-image: url('/assets/images/account/account-bg.jpg');">
    <div class="container">
        <div class="padding-top padding-bottom">
            <div class="account-area">
                <div class="section-header-3">
                    <span class="cate">welcome</span>
                    <h2 class="title">to Boleto </h2>
                </div>
                <form method="post" @onsubmit="@Submit" class="account-form" @formname="SignUp">
                    <AntiforgeryToken />

                    <div class="form-group" style="display: flex; gap: 20px;">
                        <div style="flex: 1;">
                            <label for="lastName">Họ <span>*</span></label>
                            <InputText type="text" placeholder="Nhập họ của bạn " @bind-Value="lastname" id="lastName" required />
                        </div>
                        <div style="flex: 1;">
                            <label for="firstName">Tên <span>*</span></label>
                            <InputText type="text" placeholder="Nhập tên của bạn" @bind-Value="firstname" id="firstName" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email">Email <span>*</span></label>
                        <InputText type="text" placeholder="Enter Your Email" @bind-Value="request.Email" id="email" required />
                    </div>
                    <div class="form-group">
                        <label for="password">Mật khẩu <span>*</span></label>
                        <InputText type="password" placeholder="Nhập mật khẩu của bạn" @bind-Value="request.Password" id="password" required />
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Nhập lại mật khẩu <span>*</span></label>
                        <InputText type="password" placeholder="Nhập lại mật khẩu của bạn" @bind-Value="request.PasswordConfirm" id="confirmPassword" required />
                    </div>
                    <div class="form-group checkgroup">
                        <input type="checkbox" id="agree" @bind-value="isAgree" required/>
                        <label for="agree">Tôi đồng ý với các <a href="#0">Điều khoản, Chính sách</a> và <a href="#0">Chi phí</a></label>
                    </div>
                    <div class="form-group text-center">
                        <input type="submit" value="@(isLoading ? "Đang đăng ký..." : "Đăng ký")">
                    </div>
                </form>
                <div class="option">
                    Bạn đã có tài khoản? <a href="/login">Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>
</section>

<Toast @ref="toastService.ToastComponent" />

@code {
    [SupplyParameterFromForm]
    private UserRegisterRequestDto request { get; set; } = new UserRegisterRequestDto();
    private bool isLoading = false;
    public string? lastname { get; set; }
    public string? firstname { get; set; }
    public bool isAgree { get; set; }


    private async Task Submit()
    {
        try
        {
            isLoading = true;

            // Combine names into the Model
            request.Fullname = $"{lastname} {firstname}";

            var userDto = await UserServices.Register(request);

            toastService.ShowSuccessToast("Thành công", $"Tạo thành công tài khoản {request.Fullname}");

            // Redirect user
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            toastService.ShowErrorToast("Lỗi định dạng", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}