@page "/login"
@inject ToastService toastService
@inject IUserServices UserServices
@inject HttpClient httpClient

<!-- ==========Sign-In-Section========== -->
<section class="account-section bg_img" style="background-image: url('/assets/images/account/account-bg.jpg');">
    <div class="container">
        <div class="padding-top padding-bottom">
            <div class="account-area">
                <div class="section-header-3">
                    <span class="cate">Chào bạn</span>
                    <h2 class="title">Bạn muốn xem phim gì nào? Đăng nhập ngay thôi</h2>
                </div>


                <form method="post" class="account-form" @onsubmit="HandleLogin" @formname="login">
                    <AntiforgeryToken/>
                    <div class="form-group">
                        <label for="credential">Tài khoản<span>*</span></label>
                        <InputText type="text" placeholder="Nhập tài khoản của bạn" @bind-Value="request.Email" id="credential" required />
                    </div>
                    <div class="form-group">
                        <label for="password">Mật khẩu<span>*</span></label>
                        <InputText type="password" placeholder="Nhập mật khẩu của bạn" @bind-Value="request.Password" id="password" required />
                    </div>
                    <div class="form-group text-center">
                        <input disabled="@isLoading" type="submit" value="@(isLoading ? "Đang đăng nhập..." : "Đăng nhập")">
                    </div>

                </form>
                <div class="option">
                    Chưa có tài khoản ở Boleto? <a href="/sign-up">Đăng ký ngay nào</a>
                </div>
            </div>
        </div>
    </div>
</section>

<Toast @ref="toastService.ToastComponent" />

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm]
    private UserLoginRequestDto request { get; set; } = new UserLoginRequestDto();

    private bool isLoading = false;

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;

            var claims = new List<Claim>
            {
                new Claim(ClaimTypes.Name, request.Email)
            };

            ClaimsIdentity identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            ClaimsPrincipal principal = new ClaimsPrincipal(identity);

            await HttpContext?.SignInAsync(principal);

            HttpContext.Response.Redirect("/");

            return;
        }
        catch (Exception ex)
        {
            // Show unexpected error
            toastService.ShowDangerToast($"An error occurred: {ex.Message}", "Login Error");
        }
        finally
        {
            isLoading = false;
        }
    }
}
