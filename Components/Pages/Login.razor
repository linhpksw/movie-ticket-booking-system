@page "/login"
@inject NavigationManager NavigationManager
@inject ToastService toastService
@inject IUserServices UserServices
@inject IHttpContextAccessor HttpContextAccessor

<!-- ==========Preloader========== -->
<!-- ==========Sign-In-Section========== -->
<section class="account-section bg_img" style="background-image: url('/assets/images/account/account-bg.jpg');">
    <div class="container">
        <div class="padding-top padding-bottom">
            <div class="account-area">
                <div class="section-header-3">
                    <span class="cate">Chào bạn</span>
                    <h2 class="title">Bạn muốn xem phim gì nào? Đăng nhập ngay thôi</h2>
                </div>


                <form method="post" class="account-form" @onsubmit="@HandleLogin" @formname="login">
                    <div class="form-group">
                        <label for="credential">Tài khoản<span>*</span></label>
                        <InputText type="text" placeholder="Nhập tài khoản của bạn" @bind-Value="userDto.Email" id="credential" required />
                    </div>
                    <div class="form-group">
                        <label for="password">Mật khẩu<span>*</span></label>
                        <InputText type="password" placeholder="Nhập mật khẩu của bạn" @bind-Value="userDto.Password" id="password" required />
                    </div>
                    <div class="form-group text-center">
                        <input disabled="@isLoading" placeholder=" @(isLoading ? "Đang đăng nhập..." : "Đăng nhập")" type="submit" value="Đăng nhập">
                    </div>

                </form>
                <div class="option">
                    Chưa có tài khoản ở Boleto? <a href="/sign-up">Đăng ký ngay nào</a>
                </div>
            </div>
        </div>
    </div>
</section>

<Toast @ref="toastService.ToastComponent" />

@code {
    private bool isLoading = false;
    private UserDto userDto { get; set; } = new UserDto();

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;

            var user = await UserServices.Login(userDto);

            if (user is null)
            {
                // Show error
                toastService.ShowDangerToast("Login Failed", "Invalid credentials.");
                return;
            }

            List<UserRole> userRoles = await UserServices.GetUserRolesAsync();

            var claims = new List<Claim>
            {
                new Claim(ClaimTypes.Name, userDto.Email),
                new Claim(ClaimTypes.Role, userRoles.FirstOrDefault()?.RoleId.ToString() ?? string.Empty)
            };

            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(identity);

            await HttpContextAccessor.HttpContext.SignInAsync(principal);

            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            // Show unexpected error
            toastService.ShowDangerToast($"An error occurred: {ex.Message}", "Login Error");
        }
        finally
        {
            isLoading = false;
        }
    }
}
