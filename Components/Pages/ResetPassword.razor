@page "/reset-password"
@using System.Diagnostics
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using G5_MovieTicketBookingSystem.Services.Impl
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<!-- Reset Password Section -->
<section class="account-section bg_img" data-background="./assets/images/account/account-bg.jpg">
    <div class="container">
        <div class="padding-top padding-bottom">
            <div class="account-area">
                <div class="section-header-3">
                    <span class="cate">Reset Your Password</span>
                    <h2 class="title">Enter New Password</h2>
                </div>
                <form method="post" @onsubmit="@Submit" class="account-form">
                    <AntiforgeryToken />

                    @if (Error.ContainsKey("Password"))
                    {
                        <p>@Error["Password"]</p>
                    }

                    <div class="form-group">
                        <label for="newPass">New Password<span>*</span></label>
                        <InputText type="password" placeholder="Enter New Password" @bind-Value="newPassword" id="newPass" required />
                    </div>
                    <div class="form-group">
                        <label for="confirmPass">Confirm Password<span>*</span></label>
                        <InputText type="password" placeholder="Confirm Password" @bind-Value="confirmPassword" id="confirmPass" required />
                    </div>
                    <div class="form-group text-center">
                        <input type="submit" value="Reset Password">
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@code {
    private string newPassword = "";
    private string confirmPassword = "";
    private Dictionary<string, string> Error = new Dictionary<string, string>();
    [Inject]
    public IUserServices UserServices { get; set; }

    private async Task Submit()
    {
        Error.Clear();

        if (string.IsNullOrEmpty(newPassword) || newPassword.Length < 8)
        {
            Error.Add("Password", "Password must be at least 8 characters long");
        }
        else if (newPassword != confirmPassword)
        {
            Error.Add("Password", "Passwords do not match");
        }

        if (Error.Count > 0)
        {
            return;
        }

 
       
    }
}
