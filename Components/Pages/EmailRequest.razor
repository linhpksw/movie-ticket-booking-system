@page "/request-email"
@using G5_MovieTicketBookingSystem.Util
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IUserServices userServices

<section class="account-section bg_img" data-background="./assets/images/account/account-bg.jpg">
    <div class="container">
        <div class="padding-top padding-bottom">
            <div class="account-area">
                <div class="section-header-3">
                    <span class="cate">Enter Your Email</span>
                    <h2 class="title">Receive a Verification Link</h2>
                </div>
                <form method="post" @onsubmit="@Submit" class="account-form" @formname="request-email">
                    <AntiforgeryToken />
                    <div class="form-group">
                        <label for="email1">Email<span>*</span></label>
                        <!-- Binding the input value to 'email' -->
                        <InputText type="email" placeholder="Enter Your Email" @bind-value="email" id="pass1" required />
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="text-danger">@errorMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <div class="text-danger">@email</div>
                        }
                    </div>
                    <div class="form-group text-center">
                        <input type="submit" value="Send Verification Link" class="btn btn-primary" />
                    </div>
                </form>
                <div class="option">
                    Remembered your account? <a href="/login">Login</a>
                </div>
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromForm]
    public string? email { get; set; }
    // Make sure 'email' is a public property with both get and set

    private string? errorMessage;
    private string? successMessage;

    private async Task Submit()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrEmpty(email))
        {
            errorMessage = "Please enter an email address.";
            return;
        }

        if (!IsValidEmail(email))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        try
        {
            // Tạo mật khẩu ngẫu nhiên mới
            var newPassword = HashPassword.GeneratePassword();

            // Cập nhật mật khẩu người dùng (gọi service hoặc repository để lưu mật khẩu mới)
            var user = await userServices.ChangePasswordAsync(email, HashPassword.Hashing(newPassword));
            if (user == null)
            {
                errorMessage = "Failed to update user password.";
                return;
            }

            // Gửi email xác nhận với liên kết để xác nhận mật khẩu
            var client = HttpClientFactory.CreateClient("EmailClient");
           
      

            var requestData = new
            {
                ToEmail = email,
                Subject = "Verification Link",
                Body = $"Your new password has been generated: {newPassword}\n" 
            };

            var response = await client.PostAsJsonAsync("/api/email/send", requestData);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Verification link has been sent to your email with a new password.";
            }
            else
            {
                errorMessage = $"Failed to send email. Status Code: {response.StatusCode}. Details: {responseContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }
     private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }
}
    

   
