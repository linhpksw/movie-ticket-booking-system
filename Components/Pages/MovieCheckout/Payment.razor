@page "/payment"
@using G5_MovieTicketBookingSystem.Data
@using Microsoft.EntityFrameworkCore

@inject IVnPayService VnPayService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Components.NavigationManager UriHelper
@inject IUserService UserService
@inject IOrderService OrderService
@inject IOrderItemService OrderItemService
@inject IScreenSeatService ScreenSeatService
@inject ITransactionLogService TransactionLogService
@inject IShowtimeService ShowtimeService
@inject AppDbContext _context  // Inject DbContext trực tiếp

@layout MainLayout


@code {
    private PaymentInformationModel paymentModel = new();
    private int? userId;
    private User? currentUser;

    private Order NewOrder { get; set; } = new()
        {
            OrderTimestamp = DateTime.UtcNow,
            OrderStatus = "Pending",
            TotalAmount = 0m,
            UserId = 1,
            User = new User()
            {
                Username = "GuestUser",
                Email = "guest@example.com",
                Password = "DefaultPass123!",
                Fullname = "Guest User"
            }
        };

    private List<int> screenSeatIds = new();
    private List<OrderItemDto> orderItems = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = UriHelper.ToAbsoluteUri(UriHelper.Uri.ToString());
            var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
            // ✅ Lấy thông tin thanh toán từ query string
            paymentModel.OrderType = queryParams["orderType"];
            paymentModel.Amount = double.TryParse(queryParams["amount"], out double amount) ? amount : 0;
            paymentModel.OrderDescription = queryParams["orderDescription"];
            paymentModel.Name = queryParams["name"];

            // ✅ Parse các giá trị từ query params
            if (!int.TryParse(queryParams["userId"], out int parsedUserId))
            {
                Console.WriteLine("❌ Lỗi: userId không hợp lệ.");
                return;
            }
            userId = parsedUserId;

            if (!string.IsNullOrEmpty(queryParams["screenSeatId"]))
            {
                screenSeatIds = queryParams["screenSeatId"]
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(id => int.TryParse(id.Trim(), out int seatId) ? seatId : -1)
                    .Where(seatId => seatId != -1)
                    .ToList();
            }
            if (screenSeatIds.Count == 0)
            {
                Console.WriteLine("❌ Lỗi: Không có screenSeatId hợp lệ.");
                return;
            }

            int orderItemId = int.TryParse(queryParams["orderItemId"], out int oi) ? oi : 1;
            string movieTitle = queryParams["movieTitle"] ?? "Unknown Movie";
            string seatLabel = queryParams["seatLabel"] ?? "Unknown Seat";
            string cinemaName = queryParams["cinemaName"] ?? "Unknown Cinema";
            string fullName = queryParams["fullName"] ?? "Unknown User";

            // ✅ Lấy user hiện tại
            currentUser = await UserService.GetUserByIdAsync(userId.Value);
            if (currentUser == null)
            {
                Console.WriteLine("❌ Lỗi: Không tìm thấy user.");
                return;
            }

            NewOrder.UserId = currentUser.UserId;
            NewOrder.User = currentUser;
            NewOrder.TotalAmount = (decimal)paymentModel.Amount;

            // ✅ Thêm Order mới
            await AddOrder();

            // ✅ Lấy Order vừa tạo
            Order latestOrder = await OrderService.GetLatestOrderByUserIdAsync(userId.Value);

            // ✅ Tạo OrderItem cho từng ghế
            foreach (var seatId in screenSeatIds)
            {
                var orderItem = new OrderItemDto
                    {
                        OrderItemId = orderItemId,
                        OrderId = latestOrder.OrderId,
                        ScreenSeatId = seatId,
                        PriceCharged = (decimal)paymentModel.Amount / screenSeatIds.Count
                    };
                await AddOrderItem(orderItem);
            }

            // ✅ Thêm Transaction Log
            TransactionLog transactionLog = new TransactionLog
                {
                    OrderId = latestOrder.OrderId,
                    Order = latestOrder,
                    PaymentGateway = "VNPAY",
                    PaymentStatus = "Pending",
                    Amount = latestOrder.TotalAmount,
                    TransactionTimestamp = DateTime.Now,
                    GatewayResponse = "Pending"
                };
            await TransactionLogService.AddTransactionLogAsync(transactionLog);

            if (!string.IsNullOrEmpty(paymentModel.OrderType) && paymentModel.Amount > 0)
            {
                var httpContext = HttpContextAccessor.HttpContext;
                if (httpContext != null)
                {
                    var paymentUrl = VnPayService.CreatePaymentUrl(paymentModel, httpContext);
                    if (!string.IsNullOrEmpty(paymentUrl))
                    {
                        Navigation.NavigateTo(paymentUrl, true);
                    }
                    else
                    {
                        Console.WriteLine("❌ Lỗi: Không thể tạo URL thanh toán VNPAY.");
                    }
                }
            }
            else
            {
                Console.WriteLine("❌ Lỗi: Dữ liệu thanh toán không hợp lệ.");
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Lỗi trong OnInitializedAsync: {ex.Message}");
        }
    }

    private async Task AddOrder()
    {
        if (currentUser != null)
        {
            NewOrder.User = currentUser;
        }

        await OrderService.CreateOrderAsync(NewOrder);
    }

    private async Task AddOrderItem(OrderItemDto newOrderItemDto)
    {
        var order = await OrderService.GetOrderByIdAsync(newOrderItemDto.OrderId);
        var screenSeat = await ScreenSeatService.GetScreenSeatByIdAsync(newOrderItemDto.ScreenSeatId);
        var showtime = await ShowtimeService.GetShowtimeByScreenSeatId(screenSeat.ScreenSeatId);

        var newOrderItem = new OrderItem
            {
                OrderId = newOrderItemDto.OrderId,
                ScreenSeatId = newOrderItemDto.ScreenSeatId,
                PriceCharged = newOrderItemDto.PriceCharged,
                Order = order,
                ShowtimeId = showtime.ShowtimeId,
                ScreenSeat = screenSeat,
                Showtime = showtime
            };

        if (_context.Entry(newOrderItem.ScreenSeat.Screen).State == EntityState.Detached)
        {
            _context.Attach(newOrderItem.ScreenSeat.Screen);
        }

        await OrderItemService.AddOrderItemAsync(newOrderItem);
    }
}
