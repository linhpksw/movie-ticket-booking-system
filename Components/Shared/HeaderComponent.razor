@inject NavigationManager Navigation

<header class="header-section">
    <div class="container">
        <div class="header-wrapper">
            <div class="logo">
                <a style="cursor: pointer;" @onclick="@(e => ForceReload("/"))">
                    <img src="/assets/images/logo/logo.png" alt="logo">
                </a>
            </div>
            <ul class="menu">
                <li>
                    <a style="cursor: pointer;" @onclick="@(e => ForceReload("/"))">Home</a>
                </li>
                <li>
                    <a style="cursor: pointer;" href="/check-ticket")">Check-in</a>
                </li>
                <li>
                    <a style="cursor: pointer;" href="/movie-booking-plan" )">Movie Plan</a>
                </li>
                <li>
                    <a style="cursor: pointer;" @onclick="@(e => ForceReload("/seat-plan/1"))">Seat Plan</a>
                </li>
                <li>
                    <a href="contact.html">Contact</a>
                </li>
                <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
                    <NotAuthorized>
                        <li class="header-button pr-0">
                            <a href="/sign-up">Join Us</a>
                        </li>
                    </NotAuthorized>
                    <Authorized>
                        <li class="header-button pr-0">
                            <a href="/logout">Log out</a>
                        </li>
                    </Authorized>
                </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
                
            </ul>
            <div class="header-bar d-lg-none">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</header>

@code {
    private void ForceReload(string url)
    {
        // Forces a full page reload for the given URL
        Navigation.NavigateTo(url, forceLoad: true);
    }
}